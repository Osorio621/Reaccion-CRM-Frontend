## 6. Hooks con TanStack Query

```js
// src/hooks/useDashboard.js
import { useQuery } from '@tanstack/react-query';
import { getDashboardResumen } from '../api/dashboard.api';

export function useDashboard() {
  return useQuery({
    queryKey: ['dashboard'],
    queryFn: () => getDashboardResumen().then(r => r.data),
    staleTime: 30_000,
  });
}

// src/hooks/useOportunidades.js
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import * as api from '../api/oportunidades.api';

export function useOportunidades(params) {
  return useQuery({
    queryKey: ['oportunidades', params],
    queryFn: () => api.getOportunidades(params).then(r => r.data),
  });
}

export function useCreateOportunidad() {
  const qc = useQueryClient();
  return useMutation({
    mutationFn: api.createOportunidad,
    onSuccess: () => {
      qc.invalidateQueries({ queryKey: ['oportunidades'] });
      qc.invalidateQueries({ queryKey: ['pipeline'] });
    },
  });
}

export function useCambiarEtapa() {
  const qc = useQueryClient();
  return useMutation({
    mutationFn: ({ id, data }) => api.cambiarEtapa(id, data),
    onSuccess: () => {
      qc.invalidateQueries({ queryKey: ['pipeline'] });
      qc.invalidateQueries({ queryKey: ['oportunidades'] });
    },
  });
}

// src/hooks/useSeguimientos.js
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import * as api from '../api/seguimientos.api';

export function useSeguimientosVencidos() {
  return useQuery({
    queryKey: ['seguimientos', 'vencidos'],
    queryFn: () => api.getSeguimientosVencidos().then(r => r.data),
    refetchInterval: 60_000,  // actualiza cada minuto
  });
}

export function useCerrarSeguimiento() {
  const qc = useQueryClient();
  return useMutation({
    mutationFn: ({ id, data }) => api.cerrarSeguimiento(id, data),
    onSuccess: () => qc.invalidateQueries({ queryKey: ['seguimientos'] }),
  });
}
```

