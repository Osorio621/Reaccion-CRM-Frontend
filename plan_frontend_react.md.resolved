## 3. Capa de API — Conexión con el Backend

### 3.1 axiosClient.js — Configuración con interceptores JWT

```js
// src/api/axiosClient.js
import axios from 'axios';
import { useAuthStore } from '../store/authStore';

const axiosClient = axios.create({
  baseURL: import.meta.env.VITE_API_BASE_URL,
  headers: { 'Content-Type': 'application/json' },
});

// REQUEST: agrega el Bearer token automáticamente
axiosClient.interceptors.request.use((config) => {
  const token = useAuthStore.getState().accessToken;
  if (token) config.headers.Authorization = `Bearer ${token}`;
  return config;
});

// RESPONSE: maneja 401 y hace refresh automático
axiosClient.interceptors.response.use(
  (response) => response,
  async (error) => {
    const original = error.config;
    if (error.response?.status === 401 && !original._retry) {
      original._retry = true;
      try {
        const refreshToken = useAuthStore.getState().refreshToken;
        const { data } = await axios.post(
          `${import.meta.env.VITE_API_BASE_URL}/auth/refresh`,
          { refreshToken }
        );
        useAuthStore.getState().setTokens(data.accessToken, data.refreshToken);
        original.headers.Authorization = `Bearer ${data.accessToken}`;
        return axiosClient(original);
      } catch {
        useAuthStore.getState().logout();
        window.location.href = '/login';
      }
    }
    return Promise.reject(error);
  }
);

export default axiosClient;
```

### 3.2 Módulos de API mapeados a los endpoints reales

```js
// src/api/auth.api.js
import axiosClient from './axiosClient';
export const login   = (data) => axiosClient.post('/auth/login', data);
export const refresh = (data) => axiosClient.post('/auth/refresh', data);
export const logout  = ()     => axiosClient.post('/auth/logout');

// src/api/clientes.api.js
import axiosClient from './axiosClient';
export const getClientes    = (p) => axiosClient.get('/clientes', { params: p });
export const getCliente     = (id) => axiosClient.get(`/clientes/${id}`);
export const createCliente  = (d) => axiosClient.post('/clientes', d);
export const updateCliente  = (id, d) => axiosClient.put(`/clientes/${id}`, d);
export const deleteCliente  = (id) => axiosClient.delete(`/clientes/${id}`); // borrado lógico

// src/api/oportunidades.api.js
import axiosClient from './axiosClient';
export const getOportunidades  = (p) => axiosClient.get('/oportunidades', { params: p });
export const createOportunidad = (d) => axiosClient.post('/oportunidades', d);
export const updateOportunidad = (id, d) => axiosClient.put(`/oportunidades/${id}`, d);
export const cambiarEtapa      = (id, d) => axiosClient.patch(`/oportunidades/${id}/etapa`, d);

// src/api/pipeline.api.js
import axiosClient from './axiosClient';
export const getPipeline = () => axiosClient.get('/pipeline');

// src/api/visitas.api.js
import axiosClient from './axiosClient';
export const getVisitas   = (p) => axiosClient.get('/visitas', { params: p });
export const createVisita = (d) => axiosClient.post('/visitas', d);
export const updateVisita = (id, d) => axiosClient.put(`/visitas/${id}`, d);

// src/api/seguimientos.api.js
import axiosClient from './axiosClient';
export const getSeguimientos        = (p) => axiosClient.get('/seguimientos', { params: p });
export const getSeguimientosVencidos= ()  => axiosClient.get('/seguimientos/vencidos');
export const createSeguimiento      = (d) => axiosClient.post('/seguimientos', d);
export const cerrarSeguimiento      = (id, d) => axiosClient.patch(`/seguimientos/${id}/cerrar`, d);

// src/api/ventas.api.js
import axiosClient from './axiosClient';
export const getVentas   = (p) => axiosClient.get('/ventas', { params: p });
export const createVenta = (d) => axiosClient.post('/ventas', d);
export const updateVenta = (id, d) => axiosClient.put(`/ventas/${id}`, d);

// src/api/dashboard.api.js
import axiosClient from './axiosClient';
export const getDashboardResumen = () => axiosClient.get('/dashboard/resumen');

// src/api/catalogos.api.js — requiere rol ADMIN
import axiosClient from './axiosClient';
export const getCatalogos   = (p) => axiosClient.get('/admin/catalogos', { params: p });
export const createCatalogo = (d) => axiosClient.post('/admin/catalogos', d);

// src/api/usuarios.api.js — requiere rol ADMIN
import axiosClient from './axiosClient';
export const getUsuarios   = () => axiosClient.get('/admin/usuarios');
export const createUsuario = (d) => axiosClient.post('/admin/usuarios', d);

// src/api/auditoria.api.js — requiere rol ADMIN
import axiosClient from './axiosClient';
export const getAuditoria = (p) => axiosClient.get('/admin/auditoria', { params: p });
```

